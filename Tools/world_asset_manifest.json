    "res://Asset/HexTiles/_BIOMES/biome_plains/HEX",
    "res://Asset/HexTiles/_BIOMES/biome_centralcore/HEX",
    "res://Asset/HexTiles/_BIOMES/biome_north/HEX",
    "res://Asset/HexTiles/_OVERLAYS/roads"
