node_id = "east_random_1"
spawn_entries = [{"count": 2, "faction": 0, "placement": "search_near", "role_id": "salvager", "template_prefix": "east_registry_salvager", "world_status": 1}, {"count": 1, "faction": 1, "placement": "search_far", "role_id": "raider", "template_prefix": "east_registry_raider", "world_status": 0}, {"count": 1, "faction": 2, "placement": "poi_neighbor", "role_id": "patrol", "template_prefix": "east_registry_patrol", "world_status": 1}]

