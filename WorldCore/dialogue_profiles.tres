[gd_resource type="Resource" script_class="DialogueCatalog" load_steps=5 format=3]

[ext_resource type="Script" path="res://WorldCore/DialogueCatalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://WorldCore/DialogueProfileDefinition.gd" id="2_profile"]

[sub_resource type="Resource" id="Generic"]
script = ExtResource("2_profile")
dialogue_id = "generic"
title = "ASK"
body = "They keep a wary distance, but they will answer a few words."
choices = Array[Dictionary]([{"effects": {"elapsed_minutes": 2, "exertion": 0.1}, "id": "ask_intent", "label": "Ask what they want", "preview": "Probe their immediate agenda.", "reason": "Available.", "result_body": "They watch the nearest wreckage and count the distance to the next safe place.", "result_title": "INTENT"}, {"effects": {"elapsed_minutes": 3, "exertion": 0.1}, "id": "ask_area", "label": "Ask about the area", "preview": "Local hazards and traffic.", "reason": "Available.", "result_body": "They point toward denser wreckage and warn that quiet places may already be claimed.", "result_title": "THE AREA"}])

[sub_resource type="Resource" id="Guard"]
script = ExtResource("2_profile")
dialogue_id = "central_guard"
title = "ASK // CENTRAL GUARD"
body = "Service kit. Posted pair. They talk like quota clerks handed rifles and told the edge is the job."
choices = Array[Dictionary]([{"effects": {"elapsed_minutes": 2, "exertion": 0.1}, "id": "ask_guard_central", "label": "Ask about returning to Central", "preview": "Probe the lock.", "reason": "Available.", "result_body": "'Eviction stands. Central Core is not accepting walk-backs.'", "result_title": "CLOSED"}, {"effects": {"elapsed_minutes": 2, "exertion": 0.1}, "id": "ask_guard_orders", "label": "Ask who posted them", "preview": "Ask about their orders.", "reason": "Available.", "result_body": "'Logistics desk.' No names. Just a rim shift and enough rounds to make the paperwork stick.", "result_title": "ORDERS"}])

[sub_resource type="Resource" id="Courier"]
script = ExtResource("2_profile")
dialogue_id = "route1_signal_courier"
title = "ASK // SIGNAL COURIER"
body = "A runner followed the burst made when you decoded the old record. They are not part of the abandoned site; the world sent them here because you changed what is known."
choices = Array[Dictionary]([{"effects": {"elapsed_minutes": 2, "exertion": 0.05}, "id": "ask_courier_signal", "label": "Ask what heard the signal", "preview": "Learn why the record matters.", "reason": "Available.", "result_body": "'Every arm kept a different part of the truth. The relay ledger is the only one that can clear the northern road; the others tell you what waits around it.'", "result_title": "FOUR RECORDS"}, {"effects": {"elapsed_minutes": 1, "exertion": 0.05}, "id": "ask_courier_warning", "label": "Ask who else is moving", "preview": "Get a warning about pursuit.", "reason": "Available.", "result_body": "'Scavengers chase cargo. Patrols chase trespassers. The feral things chase fresh movement. Don't mistake all three for the same enemy.'", "result_title": "MOVEMENT"}])

[resource]
script = ExtResource("1_catalog")
profiles = Array[ExtResource("2_profile")]([SubResource("Courier"), SubResource("Guard"), SubResource("Generic")])
