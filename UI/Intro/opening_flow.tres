[ext_resource type="Script" path="res://UI/Intro/OpeningFlowDefinition.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
flow_id = "central_eviction_v1"
intro_version = 1
world_seed = "ARCCROSS_DIRECTIONAL_WEB_01"
identity_catalog_path = "res://BiologicalCore/Identity/identity_catalog.tres"
campaign_definition_path = "res://WorldCore/campaign_graph.tres"
base_player_definition_path = "res://BiologicalCore/player_def.tres"
game_scene_path = "res://SystemCore/game_director.tscn"
menu_scene_path = "res://UI/MainMenu.tscn"
identity_title = "CENTRAL PERSONNEL RECORD"
identity_body = "Confirm the three entries Central permits you to retain. Pillars and appearance are not editable during expulsion processing."
confirmation_title = "RECORD CONFIRMATION"
confirmation_body = "This identity is written into the character record when you accept the eviction order."
eviction_title = "ACCESS REVOKED"
eviction_body = "Central has closed your ration account and revoked access to the hub interior. Regional infrastructure restoration is the only accepted route of appeal."
eviction_background_path = "res://Asset/Intro/CentralCore/central_eviction_office.png"
eviction_npc_portrait_path = "res://Asset/Intro/CentralCore/central_eviction_clerk.png"
eviction_speaker_name = "CENTRAL EVICTION CLERK"
eviction_dialogue = "Unfortunately for you, you've won Central's eviction lottery. Your access is revoked. Collect your assigned kit, choose a gate, and good luck out there."
departure_title = "SELECT DEPARTURE NODE"
departure_body = "Choose any adjacent Route 1 zone. The inner ring is open; only the northern route continues into deeper territory."
